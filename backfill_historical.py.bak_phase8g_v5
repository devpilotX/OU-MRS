"""
Phase 8g v3: BankNifty FUT backfill via SmartAPI searchScrip().
Both static scrip-master URLs return 404; this uses the authenticated
API endpoint instead for instrument discovery.
"""
import os, time, logging, sys, shutil
from datetime import datetime, timedelta
from pathlib import Path
import pandas as pd
from dotenv import load_dotenv
from SmartApi import SmartConnect
import pyotp

load_dotenv()
API_KEY     = os.getenv("ANGEL_API_KEY")
CLIENT_CODE = os.getenv("ANGEL_CLIENT_CODE")
MPIN        = os.getenv("ANGEL_MPIN")
TOTP_SECRET = os.getenv("ANGEL_TOTP_SECRET")

DATA_PATH  = Path("data/BANKNIFTY_FUT_1min.parquet")
START_DATE = datetime(2025, 10, 1)
END_DATE   = datetime(2026, 2, 28)

def log(msg):
    print(f"[{datetime.now().strftime('%H:%M:%S')}] {msg}", flush=True)

def login():
    smart = SmartConnect(api_key=API_KEY)
    totp = pyotp.TOTP(TOTP_SECRET).now()
    data = smart.generateSession(CLIENT_CODE, MPIN, totp)
    if not data or not data.get("status"):
        raise RuntimeError(f"Login failed: {data}")
    log("Login OK")
    return smart

def find_banknifty_futs(smart):
    """Per-month searchScrip to bypass the 2800-row cap (options crowd out FUT)."""
    # Last-Thursday expiries for Oct 2025 -> Feb 2026.
    # Dec 25, 2025 is Christmas; NSE moved Dec expiry to Dec 24 (Wed).
    candidates_by_month = [
        (datetime(2025, 10, 30), ["BANKNIFTY30OCT25FUT", "BANKNIFTY30OCT2025FUT", "BANKNIFTYOCT25FUT", "BANKNIFTY25OCTFUT"]),
        (datetime(2025, 11, 27), ["BANKNIFTY27NOV25FUT", "BANKNIFTY27NOV2025FUT", "BANKNIFTYNOV25FUT", "BANKNIFTY25NOVFUT"]),
        (datetime(2025, 12, 24), ["BANKNIFTY24DEC25FUT", "BANKNIFTY25DEC25FUT", "BANKNIFTY23DEC25FUT", "BANKNIFTYDEC25FUT", "BANKNIFTY25DECFUT"]),
        (datetime(2026, 1, 29),  ["BANKNIFTY29JAN26FUT", "BANKNIFTY29JAN2026FUT", "BANKNIFTYJAN26FUT", "BANKNIFTY26JANFUT"]),
        (datetime(2026, 2, 26),  ["BANKNIFTY26FEB26FUT", "BANKNIFTY26FEB2026FUT", "BANKNIFTYFEB26FUT", "BANKNIFTY26FEBFUT"]),
    ]
    futs = []
    for expiry, cands in candidates_by_month:
        log(f"Looking up {expiry:%Y-%m} FUT (trying {len(cands)} formats)...")
        found = False
        for sym in cands:
            try:
                resp = smart.searchScrip("NFO", sym)
            except Exception as e:
                log(f"  {sym}: err {e}")
                time.sleep(0.3)
                continue
            if not resp or not resp.get("status"):
                time.sleep(0.3)
                continue
            rows = resp.get("data") or []
            for s in rows:
                ts = (s.get("tradingsymbol") or "").upper()
                # Must be BANKNIFTY*FUT (not an option) and contain our yr+month hint
                if ts.startswith("BANKNIFTY") and ts.endswith("FUT") and "CE" not in ts and "PE" not in ts:
                    token = str(s.get("symboltoken") or s.get("token") or "")
                    if token:
                        futs.append({"symbol": ts, "token": token, "expiry": expiry})
                        log(f"  FOUND {ts} token={token}")
                        found = True
                        break
            time.sleep(0.3)
            if found:
                break
        if not found:
            log(f"  WARN: no FUT contract resolved for {expiry:%Y-%m}")
    futs.sort(key=lambda x: x["expiry"])
    # Dedupe by token
    seen, unique = set(), []
    for f in futs:
        if f["token"] not in seen:
            seen.add(f["token"])
            unique.append(f)
    log(f"Resolved {len(unique)} unique BANKNIFTY FUT contracts:")
    for f in unique:
        log(f"  {f['symbol']} token={f['token']} expiry={f['expiry']:%Y-%m-%d}")
    return unique

def fetch_chunk(smart, token, start, end):
    params = {
        "exchange": "NFO",
        "symboltoken": str(token),
        "interval": "ONE_MINUTE",
        "fromdate": start.strftime("%Y-%m-%d %H:%M"),
        "todate":   end.strftime("%Y-%m-%d %H:%M"),
    }
    try:
        resp = smart.getCandleData(params)
        if isinstance(resp, dict) and resp.get("status"):
            return resp.get("data") or []
        log(f"  chunk bad resp: {resp}")
    except Exception as e:
        log(f"  chunk err: {e}")
    return []

def fetch_contract(smart, c, prev_expiry):
    start = (prev_expiry + timedelta(days=1)) if prev_expiry else START_DATE
    start = start.replace(hour=9, minute=15, second=0, microsecond=0)
    end   = c["expiry"].replace(hour=15, minute=30, second=0, microsecond=0)
    if start > end:
        return []
    bars, cursor = [], start
    while cursor < end:
        chunk_end = min(cursor + timedelta(days=29), end)
        log(f"    {c['symbol']}: {cursor:%Y-%m-%d} -> {chunk_end:%Y-%m-%d}")
        bars.extend(fetch_chunk(smart, c["token"], cursor, chunk_end))
        time.sleep(0.4)
        cursor = chunk_end + timedelta(minutes=1)
    return bars

def main():
    log("=== Phase 8g v3 backfill START (searchScrip mode) ===")
    smart = login()
    contracts = find_banknifty_futs(smart)
    if not contracts:
        log("ERROR: no BANKNIFTY FUT contracts matched window.")
        sys.exit(1)

    all_rows = []
    prev_expiry = None
    for c in contracts:
        bars = fetch_contract(smart, c, prev_expiry)
        log(f"  -> {len(bars)} bars for {c['symbol']}")
        all_rows.extend(bars)
        prev_expiry = c["expiry"]

    log(f"Total raw bars: {len(all_rows)}")
    if not all_rows:
        log("ERROR: zero bars fetched.")
        sys.exit(1)

    df_new = pd.DataFrame(all_rows, columns=["ts","open","high","low","close","volume"])
    df_new["ts"] = pd.to_datetime(df_new["ts"])
    df_new = df_new.set_index("ts").sort_index()
    df_new = df_new[~df_new.index.duplicated(keep="first")]

    if DATA_PATH.exists():
        bak = str(DATA_PATH) + ".bak_phase8g"
        log(f"Backing up existing parquet -> {bak}")
        shutil.copy(DATA_PATH, bak)
        df_old = pd.read_parquet(DATA_PATH)
        log(f"Old bars: {len(df_old)}  New bars: {len(df_new)}")
        df_combined = pd.concat([df_old, df_new])
        df_combined = df_combined[~df_combined.index.duplicated(keep="last")].sort_index()
    else:
        df_combined = df_new

    log(f"Final: {len(df_combined)} bars  range: {df_combined.index.min()} -> {df_combined.index.max()}")
    df_combined.to_parquet(DATA_PATH)
    log(f"Saved -> {DATA_PATH}")
    log("=== Phase 8g backfill COMPLETE ===")

if __name__ == "__main__":
    main()
