# Angel SmartAPI credentials
ANGEL_API_KEY=
ANGEL_API_SECRET=
ANGEL_CLIENT_CODE=
ANGEL_MPIN=
ANGEL_TOTP_SECRET=

# Instrument tokens (rotate every expiry).
# Phase 9.8g.6: FINNIFTY removed (deprecated 15 May 2026 / Phase 9.7O),
# MIDCPNIFTY is the third leg.
BANKNIFTY_FUT_SYMBOL=
BANKNIFTY_FUT_TOKEN=
NIFTY_FUT_SYMBOL=
NIFTY_FUT_TOKEN=
MIDCPNIFTY_FUT_SYMBOL=
MIDCPNIFTY_FUT_TOKEN=

# Trading mode and capital
LIVE=false
CAPITAL=3750000
INSTRUMENTS=BNF,NF,MCN
ACCOUNT_ID=primary

# ----- Strategy params (defaults mirror current production .env on VPS) -----
OU_ADX_THRESHOLD=32
OU_Z_ENTRY=1.5
OU_HL_MULTIPLIER=5.0
OU_Z_VEL_STALL=1.0
OU_VEL_STALL_BARS=2
OU_REGIME_FILTER=CHOP,RANGE
OU_VOL_CONFIRM=on
OU_ATR_PCT_FILTER=on
OU_HL_MIN=0.5
OU_HL_MAX=20.0
OU_DISABLE_Z_VEL_STALL=on

# Phase 9.7AO: tight stops (ATR multiplier + unified z-stop band at 2.5)
OU_ATR_MULT=1.2
OU_Z_STOP_BNF=2.5
OU_Z_STOP_NF=2.5
OU_Z_STOP_MCN=2.5

# Phase 9.8h.3: trail-stop defaults updated from DSR-corrected sweep.
# Sweep top for BNF and MCN both prefer trail=3.0/0.3 (late activation,
# tight ratchet once active). Previous 2.0/0.50 was a placeholder.
# Both must be > 0 to enable.
OU_TRAIL_TRIGGER_ATR_MULT=3.0
OU_TRAIL_LOCK_PCT=0.30

# Phase 9.8h.3: BE ratchet defaults updated from sweep.
# BNF top config uses be=1.25 (arms later); MCN top uses be=0.0 (BE disabled)
# but the be=1.25 alternative gives MCN 83% of its peak. Compromise: 1.25.
# Set OU_BE_TRIGGER_ATR_MULT=0 to disable BE entirely.
OU_BE_TRIGGER_ATR_MULT=1.25
OU_BE_LOCK_ATR_MULT=0.1

# Phase 9.8h.3: Paper SL default updated from sweep.
# Both BNF and MCN top configs use paper_sl=1.5 (tighter than original 2.0).
# Catastrophic stop at entry +/- mult * ATR, intra-bar trigger, next-bar fill.
# Set OU_PAPER_SL_ATR_MULT=0 to disable.
OU_PAPER_SL_ATR_MULT=1.5

# Phase 9.7AL.1 / 9.7AN: armor stack (dual-cap, daily kill, circuit, concurrency)
NOTIONAL_LEVERAGE_MAX=3.0
DAILY_LOSS_LIMIT=-50000
STOP_CIRCUIT_THRESHOLD=3
MAX_CONCURRENT_POSITIONS=1

# Phase 9.8g.2: backtest overrides (match live tier when set)
BT_CAPITAL=
BT_LOT_SIZE=
BT_MAX_LOTS=
BT_KELLY=
BT_RISK_PCT=
BT_ADX=
BT_ZENTRY=
BT_ZSTOP=
BT_MINR2=
BT_REGIME_FILTER=
BT_DATA=

# Dashboard auth (dashboard is a separate project; values here are for local dev only)
DASHBOARD_USER=
DASHBOARD_PASS_HASH=
DASHBOARD_SECRET=

# Phase 9.8h.C.1: vol-regime gates derived from B.5 walk-forward findings.
# Master kill switch. Set to 'off' to roll back to B.5 behavior.
OU_VOL_REGIME=on
# BNF chop-trap band - skip entries when rv20 falls inside the band.
# B.5 measurement: rv20 in [0.0077, 0.0092] lost ₹25,493 across 7 trades.
OU_BNF_VOL_BAND_EXCLUDE=0.0077,0.0092
# MCN low-vol accelerator - size up when rv20 < threshold.
# B.5 measurement: rv20 < 0.0074 bucket was 5/5 wins with per-trade Sharpe 3.13.
OU_MCN_LOW_VOL_THRESHOLD=0.0074
OU_MCN_LOW_VOL_MULTIPLIER=1.5

# === Phase 9.8h.C.2: cost model v2 (per-symbol + size-aware slippage) ===
# Master switch. off (default) keeps the legacy flat BT_SLIPPAGE_TICKS.
OU_COST_MODEL_V2=off
# rv20 boundary above which high-vol surcharge fires (+1 tick by default).
OU_HIGH_VOL_THRESHOLD=0.012

# === Phase 9.8h.C.3: intra-bar gap-risk surcharge for STOP-class exits ===
# Above this bar_range/ATR ratio, an extra-tick surcharge is added to the
# C.2 estimate on STOP-class market exits (TARGET limit exits are exempt).
OU_GAP_THRESHOLD_ATR=1.5
# Ticks added per unit of excess (range/ATR - threshold).
OU_GAP_PENALTY_SLOPE=1.0

# --- backtest sample-expansion (phase 9.8h.C.4) ---
# BT_USE_INDEX: when 1/true, backtest.py loads <SYM>_INDEX_1min.parquet
# instead of <SYM>_FUT_1min.parquet. Expands sample ~4x for BNF/MCN but
# trades INDEX prices, not FUT. NIFTY fails fast (no INDEX parquet).
BT_USE_INDEX=0
# BT_INDEX_BASIS_PTS: reserved — future basis adjustment in price points
BT_INDEX_BASIS_PTS=0.0
