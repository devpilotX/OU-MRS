# Angel SmartAPI credentials
ANGEL_API_KEY=
ANGEL_API_SECRET=
ANGEL_CLIENT_CODE=
ANGEL_MPIN=
ANGEL_TOTP_SECRET=

# Instrument tokens (rotate every expiry).
# Phase 9.8g.6: FINNIFTY removed (deprecated 15 May 2026 / Phase 9.7O),
# MIDCPNIFTY is the third leg.
BANKNIFTY_FUT_SYMBOL=
BANKNIFTY_FUT_TOKEN=
NIFTY_FUT_SYMBOL=
NIFTY_FUT_TOKEN=
MIDCPNIFTY_FUT_SYMBOL=
MIDCPNIFTY_FUT_TOKEN=

# Trading mode and capital
LIVE=false
CAPITAL=3750000
INSTRUMENTS=BNF,NF,MCN
ACCOUNT_ID=primary

# ----- Strategy params (defaults mirror current production .env on VPS) -----
OU_ADX_THRESHOLD=32
OU_Z_ENTRY=1.5
OU_HL_MULTIPLIER=5.0
OU_Z_VEL_STALL=1.0
OU_VEL_STALL_BARS=2
OU_REGIME_FILTER=CHOP,RANGE
OU_VOL_CONFIRM=on
OU_ATR_PCT_FILTER=on
OU_HL_MIN=0.5
OU_HL_MAX=20.0
OU_DISABLE_Z_VEL_STALL=on

# Phase 9.7AO: tight stops (ATR multiplier + per-symbol z-stop bands)
OU_ATR_MULT=1.2
OU_Z_STOP_BNF=2.5
OU_Z_STOP_NF=3.5
OU_Z_STOP_MCN=3.5

# Trail-stop (Phase 9.5g + 9.8g.8 B10 unlock). Both must be > 0 to enable.
# Defaults match production .env on the VPS after 9.8g.8 verification.
OU_TRAIL_TRIGGER_ATR_MULT=2.0
OU_TRAIL_LOCK_PCT=0.50

# Phase 9.8h: BE ratchet (lock breakeven once peak unrealized gain >= trigger * ATR).
# Non-zero defaults (Sacred Rule #41). Set OU_BE_TRIGGER_ATR_MULT=0 to disable.
OU_BE_TRIGGER_ATR_MULT=1.0
OU_BE_LOCK_ATR_MULT=0.1

# Phase 9.8h: Paper SL (catastrophic stop at entry +/- mult * ATR, intra-bar trigger).
# Non-zero default. Set OU_PAPER_SL_ATR_MULT=0 to disable.
OU_PAPER_SL_ATR_MULT=2.0

# Phase 9.7AL.1 / 9.7AN: armor stack (dual-cap, daily kill, circuit, concurrency)
NOTIONAL_LEVERAGE_MAX=3.0
DAILY_LOSS_LIMIT=-50000
STOP_CIRCUIT_THRESHOLD=3
MAX_CONCURRENT_POSITIONS=1

# Phase 9.8g.2: backtest overrides (match live tier when set)
BT_CAPITAL=
BT_LOT_SIZE=
BT_MAX_LOTS=
BT_KELLY=
BT_RISK_PCT=
BT_ADX=
BT_ZENTRY=
BT_ZSTOP=
BT_MINR2=
BT_REGIME_FILTER=
BT_DATA=

# Dashboard auth (dashboard is a separate project; values here are for local dev only)
DASHBOARD_USER=
DASHBOARD_PASS_HASH=
DASHBOARD_SECRET=
